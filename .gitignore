__pycache__/
*.pyc
.DS_Store
node_modules/

# Compiled from app/ui/src/*.ts - regenerate with `npm install && npx tsc`
# in app/ui/, not committed as source.
app/ui/dist/

# Personal data - goals, plans, history. Never commit this, even once
# the code itself is public. See docs/05-decisions.md.
data/

# Obsidian's own workspace state (window layout, app settings) for the
# docs/ vault - personal/machine-specific, not project content. The
# .md files and their [[links]] are the actual vault; this is not.
docs/.obsidian/
