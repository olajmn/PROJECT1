<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Personal AI Agent - Architecture Overview (module-level)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend&#10;&#9632; Green = built now&#10;&#9632; Orange = external / LLM&#10;&#9632; Blue = user&#10;&#9633; Gray dashed = planned / future, not built&#10;See backend/README.md for the file table this NOW section mirrors." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1300" y="16" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- ============ NOW FRAME ============ -->
        <mxCell id="now_frame" value="NOW — built, see backend/README.md" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1220" height="740" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Layer 1: direct entry points, left to right: view, app, goal_to_plan, today -->
        <mxCell id="view" value="devtools/view.py (CLI)&#10;static HTML snapshot&#10;-&gt; data/view.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="app" value="devtools/app.py&#10;Flask, http://127.0.0.1:5050&#10;routes: /  /goal  /feedback  /history  /board" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="230" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="goalplan" value="goal_to_plan.py&#10;(also runnable directly: CLI prompt)&#10;generate_plan()  replan()&#10;describe_duration() / _resolve_duration()&#10;_ask_model()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="660" y="230" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="today" value="today.py (CLI)&#10;prints right_now from&#10;the latest saved plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="230" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Layer 1.5: single-caller leaves, directly under their one caller so the vertical edge never crosses anything -->
        <mxCell id="templates" value="devtools/templates/&#10;index.html, board.html, history.html&#10;_board.html, _plan_entry.html, _history_list.html&#10;+ devtools/static/style.css" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="400" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ollama" value="Ollama (local)&#10;llama3.1:8b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="660" y="400" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Layer 2: storage.py, the shared hub - full width so every caller's vertical lands on its top edge without crossing Layer 1.5 -->
        <mxCell id="storage" value="storage.py&#10;save_plan()   load_history()&#10;get_latest_plan()   get_board()&#10;_backfill_goal_ids()   _normalize_plan()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="1100" height="90" as="geometry" />
        </mxCell>

        <!-- Layer 3 -->
        <mxCell id="plansjson" value="data/plans.json&#10;(git-ignored, append-only history)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="730" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- User fan-out: spread exit points along User's bottom edge so the four lines don't bunch together -->
        <mxCell id="e_user_view" value="terminal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="view">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_user_app" value="browser :5050" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_user_goalplan" value="terminal (direct run)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="goalplan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_user_today" value="terminal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="today">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer 1 internal (same row, adjacent boxes only - no box sits between source and target) -->
        <mxCell id="e_view_app" value="imports render_history_page(), app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="view" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_app_goalplan" value="generate_plan() / replan() / describe_duration()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="goalplan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer 1 -> Layer 1.5 (straight down, same column as the single caller) -->
        <mxCell id="e_app_templates" value="renders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="templates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_goalplan_ollama" value="_ask_model()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goalplan" target="ollama">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer 1 -> storage (Layer 2). view/today drop straight down their own empty column;
             app/goal_to_plan route sideways through the empty corridor beside their Layer-1.5 leaf,
             so neither line crosses templates/ollama. -->
        <mxCell id="e_view_storage" value="load_history()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.09;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="view" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_app_storage" value="save_plan() / load_history() / get_board() / get_latest_plan()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0.21;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_goalplan_storage" value="save_plan() (CLI entry point)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.81;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goalplan" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_today_storage" value="get_latest_plan()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.92;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="today" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer 2 -> Layer 3, both centered, straight down -->
        <mxCell id="e_storage_json" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="storage" target="plansjson">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ VISION FRAME ============ -->
        <mxCell id="vision_frame" value="VISION — not built yet, see docs/08-technical-architecture.md (orientation only)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#fafafa;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1620" height="410" as="geometry" />
        </mxCell>

        <mxCell id="v_ios" value="iOS App (future)&#10;Swift + SwiftUI&#10;real frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="910" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_web" value="Web interface (future)&#10;timeline / goals / progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="910" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_api" value="Backend API (future)&#10;real server, not just local Flask&#10;(today: devtools/app.py plays this role, locally)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="910" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_claude" value="Claude API (optional)&#10;claude-opus-5, swap-in for Ollama" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="910" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_sync" value="Multi-device sync (future)&#10;end-to-end encrypted, local-first relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="910" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_encrypt" value="App-level encryption at rest (future)&#10;master-password derived key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="910" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="v_state" value="State / progress tracking (future)&#10;where the user is in the plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1010" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_planning" value="Planning logic (future)&#10;beyond a single LLM call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1010" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_replan" value="Deeper replanning (future)&#10;memory-aware, beyond replan()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="1010" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_temporal" value="Deeper temporal awareness (future)&#10;partially started: current date/time&#10;already sent per call (goal_to_plan.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="1010" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_sched" value="Scheduler / proactivity (future)&#10;agent-initiated check-ins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1010" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_tools" value="Tools / APIs (future)&#10;capabilities the agent can call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1010" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_aggregation" value="Aggregation (future)&#10;weather, maps, past activity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
