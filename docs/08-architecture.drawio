        </mxCell>
        <mxCell id="v_notif" value="Push notifications (future)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1110" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_memory" value="Memory re-architecture (future, undecided)&#10;folder-per-time-period + &quot;scanning&quot; planner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="1110" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_note" value="Full conceptual loop (MEMORY / WORLD / USER -&gt; REASONING -&gt; PLANNING / ACTION -&gt; RESULT -&gt; MEMORY): see docs/08-technical-architecture.md &quot;Long-term architecture&quot;." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="900" y="1110" width="740" height="50" as="geometry" />
        </mxCell>

